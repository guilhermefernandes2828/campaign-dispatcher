# Copie para .env e troque os segredos. O arquivo .env não deve ser commitado.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://campaign:campaign@127.0.0.1:54329/campaign_dispatcher?schema=public
REDIS_HOST=127.0.0.1
REDIS_PORT=63799
JWT_SECRET=troque-este-segredo-jwt
WEBHOOK_SECRET=troque-este-segredo-webhook
MOCK_LATENCY_MS=20
DISPATCH_CONCURRENCY=5
DISPATCH_ATTEMPTS=3
# Destinos rejeitados pelos providers mock, separados por vírgula. Vazio aceita todos.
MOCK_REJECT_TO=
